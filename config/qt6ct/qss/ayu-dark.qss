/* ==========================================================================
   Ayu Dark · Qt6 (Fusion)
   Тонкие правки поверх палитры: скругления, аккуратные границы,
   акцентный фокус. Подключается через qt6ct.
   ========================================================================== */

QToolTip {
    background-color: #11151c;
    color: #bfbdb6;
    border: 1px solid #1f2630;
    padding: 4px 6px;
}

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QComboBox {
    background-color: #0d1017;
    color: #bfbdb6;
    border: 1px solid #1f2630;
    border-radius: 6px;
    padding: 4px 6px;
    selection-background-color: #59c2ff;
    selection-color: #0a0e14;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QComboBox:focus {
    border: 1px solid #59c2ff;
}

QPushButton, QToolButton {
    background-color: #11151c;
    color: #bfbdb6;
    border: 1px solid #1f2630;
    border-radius: 6px;
    padding: 5px 12px;
}

QPushButton:hover, QToolButton:hover {
    background-color: #151b26;
    border-color: #2b3441;
}

QPushButton:pressed, QToolButton:pressed {
    background-color: #0a0e14;
}

QPushButton:checked, QToolButton:checked {
    background-color: #59c2ff;
    color: #0a0e14;
    border-color: #59c2ff;
}

QMenu, QMenuBar, QStatusBar {
    background-color: #11151c;
    color: #bfbdb6;
    border: 1px solid #1f2630;
}

QMenu::item:selected {
    background-color: #59c2ff;
    color: #0a0e14;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #0a0e14;
    border: none;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #2b3441;
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:hover {
    background: #59c2ff;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QHeaderView::section {
    background-color: #11151c;
    color: #8a9199;
    border: none;
    border-bottom: 1px solid #1f2630;
    padding: 5px;
}
