// ============================================================================
//  niri · Ayu Dark
//  ----------------------------------------------------------------------------
//  Модульный конфиг. Точка входа: config.kdl
//  Все настройки разложены по файлам в modules/ — правьте их, а не этот файл.
//
//  Порядок include имеет значение: более поздние значения переопределяют
//  более ранние (напр. layout.kdl задаёт оформление, rules.kdl — правила окон).
//
//  Документация: https://niri-wm.github.io/niri/Configuration:-Introduction
// ============================================================================

// Окружение сессии, курсор, XDG-переменные, скриншоты.
include "modules/environment.kdl"

// Клавиатура, тачпад, мышь.
include "modules/input.kdl"

// Мониторы: DP-1 (1920x1080@200) + HDMI-A-1 (1920x1080@60).
include "modules/outputs.kdl"

// Отступы, ширина колонок, фокус-ринг, тени, скругления.
include "modules/layout.kdl"

// Анимации.
include "modules/animations.kdl"

// Правила для окон (плавающие диалоги, скругления, защита от захвата).
include "modules/rules.kdl"

// Автозапуск: waybar, mako, обои, буфер обмена, OSD.
include "modules/autostart.kdl"

// Горячие клавиши.
include "modules/binds.kdl"
