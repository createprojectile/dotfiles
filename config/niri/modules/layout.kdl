// ============================================================================
//  Раскладка и оформление окон
// ============================================================================

layout {
    // Отступ от краёв экрана и между окнами.
    gaps 10

    // Центрировать колонку, только если она не помещается.
    center-focused-column "on-overflow"

    // Разрешить пустое рабочее пространство выше первого (проще создавать новые).
    empty-workspace-above-first true

    // Пресеты ширины колонки для Mod+R.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // Тонкое свечение вокруг активного окна в цвет акцента Ayu.
    focus-ring {
        width 2
        active-color "#59c2ff"
        inactive-color "#1f2630"
    }

    // Постоянная рамка не нужна — используем только focus-ring.
    border {
        off
    }

    // Мягкая тень под окнами.
    shadow {
        on
        softness 24
        spread 2
        offset x=0 y=5
        color "#00000066"
    }

    struts {
    }
}

// Скругления окон задаются глобальным правилом в rules.kdl.
