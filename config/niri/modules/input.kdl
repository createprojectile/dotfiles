// ============================================================================
//  Устройства ввода
// ============================================================================

input {
    keyboard {
        xkb {
            // Раскладки и переключение по Alt+Shift.
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }

        numlock

        // Задержка и частота повтора (мс / символов в секунду).
        repeat-delay 300
        repeat-rate 40
    }

    touchpad {
        tap
        dwt          // игнорировать касания во время печати
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
    }

    mouse {
        // Предсказуемый курсор без ускорения — удобно для шутеров и точной работы.
        accel-profile "flat"
    }

    // Фокус следует за мышью только для окон, целиком видимых на экране.
    // Раскомментируйте, если привыкли к такому поведению.
    // focus-follows-mouse max-scroll-amount="0%"
}
