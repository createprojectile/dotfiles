// ============================================================================
//  Мониторы
//  DP-1     — Xiaomi Mi Monitor, 1920x1080@200 Гц (основной, слева)
//  HDMI-A-1 — Acer H233H,       1920x1080@60 Гц  (справа)
//
//  Если монитор отключён, niri просто игнорирует его секцию.
//  Список выходов: niri msg outputs
// ============================================================================

output "DP-1" {
    mode "1920x1080@200.000"
    position x=0 y=0
    scale 1
    transform "normal"

    // Адаптивная синхронизация (монитор её поддерживает).
    variable-refresh-rate

    // Фон под обоями и в момент старта — без белой вспышки.
    background-color "#0a0e14"
}

output "HDMI-A-1" {
    mode "1920x1080@60.000"
    position x=1920 y=0
    scale 1
    transform "normal"
    background-color "#0a0e14"
}
